# MongoDB Connection (use mongodb://localhost:27017 locally or MongoDB Atlas SRV URI in production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fraudguard_db

# JWT Authentication Settings
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Machine Learning Artifact Paths (relative to Backend/ or resolved automatically via pathlib)
MODEL_PATH=../ml/models/fraud_model.joblib
PREPROCESSOR_PATH=../ml/models/preprocessor.joblib
FEATURE_NAMES_PATH=../ml/models/feature_names.json
METRICS_PATH=../ml/reports/metrics.json

# Allowed CORS Origins (comma-separated list of frontend URLs, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
